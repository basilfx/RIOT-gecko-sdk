root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# This is not accurate for all source code, but it is a good starting point.
[*.{c,h}]
indent_size = 2

[*.patch]
insert_final_newline = unset
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
